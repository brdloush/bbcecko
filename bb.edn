{:paths ["src"]
 ;; gtkiccup has no release tag yet, so this pins a commit on its main branch.
 ;; Its deps.edn brings Replicant along.
 :deps {io.github.brdloush/gtkiccup {:git/sha "a58fcafcd5c8006d9f6b1d2a5eb9c946eec58304"}}

 :tasks
 {run {:override-builtin true
       :doc "Start bbCéčko. bb run [folder-or-file]"
       :requires ([babashka.process])
       ;; -Xmx keeps the heap small; bb honours it only on the command line,
       ;; so the task re-execs babashka with it.
       :task (apply babashka.process/exec
                    "bb" "--config" "bb.edn" "-Xmx256m" "-m" "bbcecko.main"
                    *command-line-args*)}

  jar {:doc "Build target/bbcecko.jar: the app and its deps in one file, run with bb -jar."
       :task (do (babashka.fs/create-dirs "target")
                 (shell "bb" "--config" "bb.edn" "uberjar" "target/bbcecko.jar" "-m" "bbcecko.main"))
       :requires ([babashka.fs])}

  formula {:doc "Write the Homebrew formula. bb formula release [version] [out.rb] | bb formula local [dir]"
           :task (apply shell "bb" "--config" "bb.edn" "packaging/homebrew/formula.clj" *command-line-args*)}

  install {:doc "Put bbcecko on your PATH (~/.local/bin) and in the application menu."
           :requires ([bbcecko.desktop :as d])
           :task (d/install! (System/getProperty "user.dir"))}

  uninstall {:doc "Remove what `bb install` added."
             :requires ([bbcecko.desktop :as d])
             :task (d/uninstall! (System/getProperty "user.dir"))}

  smoke {:doc "Drive the real app end to end and take screenshots. bb smoke [out-dir]"
         :task (apply shell "bb" "--config" "bb.edn" "dev/smoke.clj" *command-line-args*)}

  test {:doc "Run the tests (no window needed)."
        :extra-paths ["test"]
        :requires ([clojure.test :as t] [bbcecko.compiler-test] [bbcecko.files-test] [bbcecko.runner-test])
        :task (let [{:keys [fail error]} (t/run-tests 'bbcecko.compiler-test 'bbcecko.files-test 'bbcecko.runner-test)]
                (when (pos? (+ fail error)) (System/exit 1)))}}}
